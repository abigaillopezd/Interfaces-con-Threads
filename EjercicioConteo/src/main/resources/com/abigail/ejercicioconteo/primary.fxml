<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abigail.ejercicioconteo.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>

    <Label text="Contar número de clics" />
    <TextField fx:id="txtClicks" editable="false" text="0" alignment="CENTER" maxWidth="300.0" />
    <Button fx:id="btnContar" text="¡Contar!" onAction="#handleBtnContar" />

    <Label text="Esperar 10 segundos">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </Label>
    
    <ProgressBar fx:id="progressBar" progress="0.0" prefWidth="300.0" />
    <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#handleBtnEsperar" />
</VBox>